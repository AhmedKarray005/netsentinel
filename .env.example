# Copy to .env and adjust. .env is git-ignored. No secrets are needed by NetSentinel.
NETSENTINEL_LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR
NETSENTINEL_LOG_FORMAT=json       # json | text
NETSENTINEL_MAX_UPLOAD_MB=50      # keep client_max_body_size in docker/nginx.conf just above
NETSENTINEL_WEB_PORT=8080         # dashboard: http://localhost:8080
NETSENTINEL_API_PORT=8000         # API docs:  http://localhost:8000/docs
